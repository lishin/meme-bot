# ==========================================
# Robinhood Chain Pons V2 Bot Configuration
# ==========================================

# 1. Private Key (DO NOT SHARE OR COMMIT TO GIT)
# Put your 64-character private key here (with or without 0x prefix)
PRIVATE_KEY=

# 2. Safety Mode: Set to false when you want live real transactions!
# While DRY_RUN=true, the bot monitors, analyzes, and simulates buys/sells without spending ETH.
DRY_RUN=true

# 3. Buy & Sizing Settings
BUY_AMOUNT_ETH=0.002
SLIPPAGE_PCT=15.0
MAX_ACTIVE_POSITIONS=3

# 4. Pair Asset Filter
# ETH_ONLY: Only buy tokens launched with Native ETH pair (safe standard)
# STOCK_ONLY: Only buy tokens paired with NVDA (app.long.xyz stock meme)
# ALL: Any quote asset
PAIR_FILTER=ETH_ONLY

# 5. Curve Sniping Range (Line B)
# 0.0 to 70.0 means buy early on the curve, but do NOT buy after 70% progress to avoid graduation dump
MIN_CURVE_PROGRESS=0.0
MAX_CURVE_PROGRESS=70.0

# 6. Exit & Decay Rules (Line C)
TAKE_PROFIT_PCT=100.0
STOP_LOSS_PCT=30.0
DECAY_MAX_HOLD_MINUTES=60
MAX_DEV_LAUNCHES=10

# 7. Network RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
